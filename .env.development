# MSCureChain Patient App - Development Environment
# ⚠️  This file OVERRIDES .env in development mode (Expo loads it with higher priority)
# ⚠️  DO NOT use 127.0.0.1 or localhost for physical Android/iOS devices

# ─── LOCAL BACKEND ────────────────────────────────────────────────────────────
# Your Mac's Network IP: 192.168.29.48 (backend running on port 5003)
# Physical device MUST use the Network IP — localhost = the phone itself, not your Mac
# EXPO_PUBLIC_API_URL=http://192.168.31.47:5003/api

# ─── Alternative URLs (uncomment as needed) ───────────────────────────────────
EXPO_PUBLIC_API_URL=https://www.mscurechain.com/api

# Debug
REACT_APP_DEBUG_MODE=true
REACT_APP_NAME=MSCureChain Patient App (Dev - Local)
