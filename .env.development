# MSCureChain Patient App - Development Environment Configuration
# Used for local development and testing

# API Configuration
# CRITICAL: Use your machine's LOCAL NETWORK IP address (NOT 127.0.0.1 or localhost)
# Your PC IP: 192.168.29.249
# Your device/emulator IP: 192.168.29.70
REACT_APP_API_URL=https://www.mscurechain.com/api

# Alternative URLs if the above doesn't work:
# For Android emulator: http://10.0.2.2:5003/api
# For iOS simulator: http://localhost:5003/api
# For physical device on same WiFi: http://192.168.29.249:5003/api

# Logging
# Set to true to enable detailed logging in development
REACT_APP_DEBUG_MODE=true

# App Name
REACT_APP_NAME=MSCureChain Patient App (Dev)
