{
  "expo": {
    "name": "MSCureChain",
    "slug": "mscurechain-patient-app-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#006AF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mscurechain.patient"
    },
    "android": {
      "package": "com.mscurechain.patient",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#006AF5"
      },
      "permissions": [
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "970ddc5b-7480-4da1-b637-cd95ecb947ba"
      }
    }
  }
}
